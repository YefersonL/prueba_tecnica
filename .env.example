# Variables de entorno para el sistema de soporte fintech
# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitees el archivo .env con valores reales.

# API key de Google Generative AI (Gemini)
# Sin esta variable, el sistema usa MockLLMClient (solo para tests/dev)
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Ruta al archivo SQLite (default: support_system.db en el directorio de trabajo)
# DB_PATH=support_system.db
