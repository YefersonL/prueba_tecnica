# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Distribution / packaging
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# SQLite database (generado en runtime)
*.db
*.sqlite3

# Variables de entorno (API keys — nunca commitear)
.env
.env.*
!.env.example

# Credenciales y llaves de servicio (GCP, Google Chat, etc.)
credentials/
*service_account*.json
*.pem
# Logs
*.log
